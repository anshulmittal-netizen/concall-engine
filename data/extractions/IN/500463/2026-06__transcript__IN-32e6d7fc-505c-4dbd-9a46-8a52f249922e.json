 "summary": {
  "headline": "Black Box Q1 FY27 revenue hit a record INR1,719 crore (+24% YoY) and order backlog reached ~US$950 million (+83%), with FY27 revenue guided to INR7,800–8,000 crore.",
  "overview": "Q1 FY27 delivered record quarterly revenue of INR1,719 crore (+24% YoY), with EBITDA of INR160 crore (+38%) and PAT of INR56 crore (+18%), and EBITDA margin up 90 bps to 9.3%. Order bookings were US$339 million, lifting backlog to about US$950 million. About INR60 crore of revenue came from the newly acquired Brazilian entity 2S, which was consolidated for two months. Management reiterated FY27 guidance and a long-term aspiration of INR18,000 crore (US$2 billion) revenue by FY30, with about INR6,000 crore of that expected from M&A.",
  "financial_highlights": [
   {
    "metric": "Revenue",
    "value": "INR1,719 crore",
    "change": "+24% YoY; highest ever quarterly revenue"
   },
   {
    "metric": "EBITDA",
    "value": "INR160 crore",
    "change": "+38% YoY"
   },
   {
    "metric": "EBITDA margin",
    "value": "9.3%",
    "change": "+90 bps YoY"
   },
   {
    "metric": "Profit after tax",
    "value": "INR56 crore",
    "change": "+18% YoY"
   },
   {
    "metric": "Order bookings",
    "value": "US$339 million",
    "change": "Not stated"
   },
   {
    "metric": "Order backlog",
    "value": "~US$950 million",
    "change": "+83% since start of transformation journey (YoY as stated in CEO remarks)"
   },
   {
    "metric": "Other income",
    "value": "INR4 crore",
    "change": "Not stated"
   },
   {
    "metric": "Revenue from 2S (Brazil, two months consolidated)",
    "value": "~INR60 crore",
    "change": "Inorganic contribution"
   }
  ],
  "segments": [
   {
    "name": "Data center / hyperscale",
    "commentary": "Added a new global US hyperscaler order of US$131 million (about INR1,240 crore); management says work on site starts only from November given gigawatt-plus sites. Data center engagements run 24–36 months."
   },
   {
    "name": "Non-data center enterprise",
    "commentary": "Management expects non-hyperscale enterprise to grow at about 10% (modest double-digit); blended growth about 25%."
   },
   {
    "name": "Technology products (TPS)",
    "commentary": "Product business expected to grow about 20% in FY27 but remains loss-making at EBIT level; focus narrowed to mission-critical products such as KVM (Emerald)."
   },
   {
    "name": "2S (Brazil)",
    "commentary": "Contributed about INR60 crore in Q1; acquisition adds about US$50 million annual revenue, extends networking, cybersecurity and managed services into Latin America."
   }
  ],
