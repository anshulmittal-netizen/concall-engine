   },
   {
    "metric": "Average annual revenue per EBO (FY26)",
    "value": "about INR75 lakh",
    "change": ""
   }
  ],
  "segments": [
   {
    "name": "Retail (EBO stores)",
    "commentary": "Store count at 427 after opening 5 new stores and closing 7 underperforming stores in Q1. About 59% of stores are in Tier 2 and 3 cities, per an analyst question. Management said new stores are generating good revenue."
   },
   {
    "name": "D2C / digital",
    "commentary": "Management said a growing share of marketing is going to Google and Meta, and that the D2C business is being built out. No figures were disclosed."
   }
  ],
  "guidance_outlook": [
   "Marketing spend guided at 8% to 10% of revenue through FY27; Q1 was about 8.5%.",
   "Same-store revenue growth targeted in the mid-single-digit range for FY27.",
   "Management declined to give growth numbers for the next one to two years, saying it cannot predict them for about two years.",
   "Management said the transformation may not show in visible numbers for a few quarters, and inventory days should reduce over time (no target given)."
  ],
