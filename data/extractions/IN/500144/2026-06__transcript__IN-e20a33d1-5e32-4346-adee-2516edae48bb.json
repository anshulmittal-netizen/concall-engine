 "summary": {
  "headline": "Finolex Cables Q1 FY27 revenue rose 44% to INR 2,013 crore and PAT 59% to INR 221 crore, helped by a temporary communication cable margin spike near 30%.",
  "overview": "Revenue from operations grew about 44% YoY to INR 2,013 crore, with PBT up 62% to INR 277 crore and PAT up 59% to INR 221 crore. Electrical cables (INR 1,767 crore, up 47%) drove growth, led by high double-digit volume growth in auto, battery, flexible, solar and agricultural cables, while building wires grew only low single digits. Communication cables rose 62% to INR 176 crore at close to 30% margins, which management said is inflated by low-cost opening inventory and will normalise. Copper rod revenue collapsed to INR 8 crore from INR 403 crore as the rod plant was shut for lack of LPG.",
  "financial_highlights": [
   {
    "metric": "Revenue from operations",
    "value": "INR 2,013 crore",
    "change": "+44% YoY (from INR 1,396 crore)"
   },
   {
    "metric": "Profit before tax",
    "value": "INR 277 crore",
    "change": "+62% YoY (from INR 171 crore)"
   },
   {
    "metric": "Profit after tax",
    "value": "INR 221 crore",
    "change": "+59% YoY (from INR 139 crore)"
   },
   {
    "metric": "PBT margin",
    "value": "13.4%",
    "change": "from 11.8% in Q1 FY26"
   },
   {
    "metric": "PAT margin",
    "value": "10.7%",
    "change": "from 9.6% in Q1 FY26"
   },
   {
    "metric": "EBITDA margin (as cited by analyst, not reported by management)",
    "value": "~12.5%",
    "change": "vs ~10.5% in Q4 FY26 and 9.4% in Q1 FY26"
   },
   {
    "metric": "Electrical cables revenue",
    "value": "INR 1,767 crore",
    "change": "+47% YoY (from INR 1,206 crore)"
   },
   {
    "metric": "Communication cables revenue",
    "value": "INR 176 crore",
    "change": "+62% YoY (from INR 109 crore); margin close to 30%"
   },
   {
    "metric": "Copper rod revenue",
    "value": "INR 8 crore",
    "change": "vs INR 403 crore in Q1 FY26"
   },
   {
    "metric": "Exports (total company)",
    "value": "About INR 50 crore",
    "change": "almost equal to full FY26 export value"
   },
   {
    "metric": "JV revenue / profit",
    "value": "INR 87 crore / INR 7 crore",
    "change": "JV FY26 profit was INR 24 crore; trend continuing"
   }
  ],
  "segments": [
   {
    "name": "Electrical cables",
    "commentary": "Revenue INR 1,767 crore, up 47% YoY; growth volume-led in auto, battery, flexible, solar and agri cables (high double digits), building wire only low single-digit volume growth. Management sees domestic electrical margin at about 10.5%, sustainable."
   },
   {
    "name": "Communication cables",
    "commentary": "Revenue INR 176 crore, up 62% YoY, volumes up about 30%; margin close to 30% on opening inventory bought at lower cost. Management expects margins to settle to low double digits by year-end; INR 35-40 crore of the revenue was exports to US and Europe."
   },
   {
    "name": "Copper rod",
    "commentary": "Revenue collapsed to INR 8 crore from INR 403 crore as the rod plant was shut due to restricted commercial LPG availability."
   },
   {
    "name": "Fiber / preform (expansion, not yet reported separately)",
    "commentary": "Preform plant (100 metric ton, equivalent to about 4 million fiber km) commenced production and is stabilising. Draw tower expansion from 4 to 8 million fiber km being done in one phase, targeted by September/end-Q2 FY27."
   }
  ],
